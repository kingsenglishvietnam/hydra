;
; iddseat-remote.inf -- Hydra virtual display, REMOTE-SESSION variant
;
; Aligned with iddseat.inf on 2026-08-20, once that one was proven to load and
; present a display. Same structure throughout; the differences below are the
; ONLY ones a remote-session IDD needs, and each is load-bearing.
;
; DIFFERENCES FROM THE CONSOLE INF, and why:
;
;   Bare hardware ID, no Root\ prefix
;       The remote-desktop stack creates the devnode, not devcon and not
;       SwDeviceCreate. A Root\ ID would be a root-enumerated device, which is
;       the wrong shape -- and IddCxAdapterInitAsync FAILS if
;       REMOTE_SESSION_DRIVER is set on a device the RD stack did not create.
;       There is no way to test this variant with devcon or devgen; it only
;       comes up through HydraProto.
;
;   UmdfHostProcessSharing = ProcessSharingDisabled
;       One host process per session. Remote IDDs are per-session by nature and
;       a shared host defeats the isolation.
;
;   NO DeviceGroupId
;       Grouping is the opposite of what ProcessSharingDisabled asks for. The
;       console INF sets one; this must not.
;
;   Its own service name and CatalogFile
;       So console and remote packages can sit in the driver store together.
;       They are mutually exclusive at runtime -- console and remote adapter
;       flags cannot both be set -- but two packages claiming one service name
;       fails confusingly rather than loudly.
;
; The DRIVER differences are in iddseat.cpp under /DHYDRA_REMOTE_IDD:
; IDDCX_ADAPTER_FLAGS_REMOTE_SESSION_DRIVER plus the mandatory
; USE_SMALLEST_MODE, and the IddCxAdapterDisplayConfigUpdate2 call without
; which a remote session's display paths never activate.
;
; THE THREE FIXES THAT MADE THE CONSOLE BUILD WORK apply here automatically --
; they are in build-driver.ps1 and iddseat.cpp, which this variant shares:
;   1. /DUMDF_VERSION_MAJOR=2 /DUMDF_VERSION_MINOR=<minor> at compile time.
;      Without them WDF_BIND_INFO is malformed and the framework rejects the
;      driver at load level 0 with 0xD000000D, before DriverEntry.
;   2. EndPointDiagnostics.pFirmwareVersion / pHardwareVersion must be non-null
;      or IddCxAdapterInitAsync returns STATUS_INVALID_PARAMETER.
;   3. FillSignal must set totalSize == activeSize. An indirect display has no
;      blanking interval, and IddCxMonitorArrival rejects a mode that has one.
;
; UmdfExtensions = IddCx0102 is not a guess. The registry names it:
;   HKLM\SYSTEM\CurrentControlSet\Control\Wdf\UMDF\IddCx\Versions\1\2
;     Service = IddCx0102
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=iddseat-remote.cat
DriverVer = 08/20/2026,1.6.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
; Bare ID only -- the RD stack creates this devnode. See the note above.
%DeviceName%=MyDevice_Install, HydraSeat_RemoteIDD_v1

[SourceDisksFiles]
iddseat.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
; IndirectKmd is the kernel-mode half of the indirect display stack -- the
; partner the IddCx class extension binds to. Every working IddCx INF has it.
; NO DeviceGroupId here: see the note above.
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"

[MyDevice_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[MyDevice_Install.NT.Wdf]
UmdfService=iddseatremote,iddseatremote_Install
UmdfServiceOrder=iddseatremote
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfHostProcessSharing = ProcessSharingDisabled

[iddseatremote_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\iddseat.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
iddseat.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Hydra"
DiskName = "Hydra Seat Display Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="Hydra Virtual Seat Display (Remote Session)"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
