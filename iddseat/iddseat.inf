;
; iddseat.inf -- Hydra virtual display (IddCx indirect display driver)
;
; STRUCTURAL CLONE OF MttVDD.inf, 2026-08-19.
;
; MttVDD (VirtualDrivers/Virtual-Display-Driver 25.7.23) is a THIRD-PARTY IddCx
; driver that loads on this exact machine right now -- ROOT\DISPLAY\0000, Status
; OK. It is a better reference than Microsoft's rdpidd.inf, which may be
; special-cased by the OS, and better than the WDK sample, which we could only
; get to load once.
;
; Everything here follows MttVDD's structure. Only names, hardware IDs and the
; binary differ. Five days of layered edits have been stripped back to what
; demonstrably works.
;
; WHAT WAS REMOVED, and why -- do not add these back without evidence:
;
;   Include=WUDFRD.inf / Needs=WUDFRD.NT.Services
;       MttVDD uses an EXPLICIT AddService with its own [WUDFRD_ServiceInstall]
;       section instead. rdpidd.inf uses Include/Needs, but rdpidd is Microsoft's
;       own and is not a safe model. Ours had Include/Needs and failed.
;
;   Include/Needs in [.NT] and [.NT.hw]
;       MttVDD has neither -- just CopyFiles and AddReg. Ours had both.
;
;   HKR,, Security, , "D:P(A;;GA;;;WD)"
;       Taken from rdpidd.inf on 2026-08-19 and it produced the FIRST EVER
;       successful load of this driver -- but it did not reproduce, and MttVDD
;       works with no descriptor at all. So it is not the answer. Left out to
;       match the working reference. If a load fails with 0xD000000D and
;       everything else matches, this is worth ONE experiment, not a permanent
;       addition.
;
;   UmdfHostProcessSharing = ProcessSharingDisabled
;       Required for REMOTE IDDs (one host per session) -- belongs in
;       iddseat-remote.inf, not here. MttVDD, a console IDD, does not set it.
;
;   UmdfImpersonationLevel = Identification
;       rdpidd sets it; MttVDD does not.
;
;   UmdfFileObjectPolicy / UmdfFsContextUsePolicy
;       UMDF 1.x-era directives. Neither MttVDD nor the WDK sample has them.
;
; VERSIONS. MttVDD declares UmdfLibraryVersion=2.25.0. We use the $UMDFVERSION$
; token so build-driver.ps1 substitutes whatever $umdf it actually LINKS
; against -- the declared version and the linked WdfDriverStubUm.lib must agree,
; and hardcoding invites them to drift. See commit 1427b7a.
;
; UmdfExtensions = IddCx0102 is NOT a guess. The registry names it:
;   HKLM\SYSTEM\CurrentControlSet\Control\Wdf\UMDF\IddCx\Versions\1\2
;     Service = IddCx0102
; That is the only IddCx class extension registered on this OS, whatever version
; headers the WDK ships. Do not "update" it to match the header version.
;
; HARDWARE IDs. Two, exactly as MttVDD:
;   Root\HydraSeat  -- for devcon install / root enumeration (persistent)
;   HydraSeat       -- bare, for SwDeviceCreate (hydrad, devgen)
; A device on the SWD enumerator claiming only a Root\ ID is malformed.
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=iddseat.cat
; A concrete value so the INF parses even if built without stampinf; the build's
; stampinf step overwrites this with the real date and version.
DriverVer = 08/19/2026,1.2.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=MyDevice_Install, Root\HydraSeat
%DeviceName%=MyDevice_Install, HydraSeat

[SourceDisksFiles]
iddseat.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
; IndirectKmd is the kernel-mode half of the indirect display stack -- the
; partner the IddCx class extension binds to. Every working IddCx INF has it:
; MttVDD, rdpidd, and the WDK sample.
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "HydraSeatGroup"

[MyDevice_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[MyDevice_Install.NT.Wdf]
UmdfService=iddseat,iddseat_Install
UmdfServiceOrder=iddseat
UmdfKernelModeClientPolicy = AllowKernelModeClients

[iddseat_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\iddseat.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
iddseat.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Hydra"
DiskName = "Hydra Seat Display Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="Hydra Virtual Seat Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
